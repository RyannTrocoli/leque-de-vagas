generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Vaga {
  id              String   @id
  titulo          String
  empresa         String
  empresaSlug     String
  area            String
  senioridade     String
  local           String
  aceitaIniciante Boolean  @default(false)
  descricao       String
  publicadaEm     String?
  criadaEm        DateTime @default(now())
  arquivada       Boolean  @default(false)
  candidaturas    Candidatura[]
}

// Frente 2. O slug e a chave porque ja era o identificador do projeto:
// e o que a Vaga guarda em empresaSlug e o que aparece na URL.
model Empresa {
  slug      String   @id
  nome      String
  sobre     String
  site      String
  editadaEm DateTime @updatedAt
}

model Candidatura {
  id          String   @id @default(uuid())
  vagaId      String
  vaga        Vaga     @relation(fields: [vagaId], references: [id])
  nome        String
  email       String
  habilidades String
  criadaEm    DateTime @default(now())
}
